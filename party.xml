<tryton>
    <data>
        <record model="ir.ui.view" id="identifier_form">
            <field name="model">party.identifier</field>
            <field name="inherit" ref="party.identifier_form"/>
            <field name="name">identifier_form</field>
        </record>
        <record model="ir.ui.view" id="identifier_list">
            <field name="model">party.identifier</field>
            <field name="inherit" ref="party.identifier_list"/>
            <field name="name">identifier_list</field>
        </record>
        <record model="ir.ui.view" id="identifier_list_sequence">
            <field name="model">party.identifier</field>
            <field name="inherit" ref="party.identifier_list_sequence"/>
            <field name="name">identifier_list</field>
        </record>
        <!-- Validate Tax Identifier/Name Wizard -->
        <record model="ir.model.button" id="identifier_check_aeat_button">
            <field name="model">party.identifier</field>
            <field name="name">check_aeat_button</field>
            <field name="string">Validate AEAT</field>
        </record>
        <record model="ir.action.wizard" id="act_validate_nif_name">
            <field name="name">Validate Tax Identifier/Name</field>
            <field name="wiz_name">party.validate_nif_name</field>
        </record>
        <record model="ir.action.keyword" id="act_validate_nif_name_keyword">
            <field name="keyword">form_action</field>
            <field name="model">party.party,-1</field>
            <field name="action" ref="act_validate_nif_name"/>
        </record>
        <record model="ir.ui.view" id="validate_nif_name_start_view_form">
            <field name="model">party.validate_nif_name.start</field>
            <field name="type">form</field>
            <field name="name">validate_nif_name_start_form</field>
        </record>
        <record model="ir.ui.view" id="validate_nif_name_party_view_tree">
            <field name="model">party.validate_nif_name.start.party</field>
            <field name="type">tree</field>
            <field name="name">validate_nif_name_party_tree</field>
        </record>
    </data>
    <data noupdate="1">
        <record model="ir.cron" id="cron_party_identifier_check_aeat">
            <field name="method">party.identifier|check_aeat</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
        </record>
    </data>
</tryton>
